# PostgreSQL
DB_USER=ai_hub_user
DB_PASSWORD=your_secure_password # CHANGE THIS to a strong, unique password
DB_NAME=ai_learning_hub_db
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}

# Gemini (Primary Model - Multimodal)
GEMINI_API_KEY=your_gemini_api_key

# Groq (Fast Model - Intent Classification)
GROQ_API_KEY=your_groq_api_key

# Qdrant (Vector Database)
QDRANT_HOST=vector-db
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Redis (Task Queue)
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO (S3-compatible Storage)
MINIO_ROOT_USER=CHANGEME_minio_access_key
MINIO_ROOT_PASSWORD=CHANGEME_minio_secret_key
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_NAME=documents-bucket
MINIO_SECURE=false

# Application Settings
SECRET_KEY=CHANGEME_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Database Connection Pooling
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Application
APP_NAME=Multimodal AI Learning Hub
DEBUG=false
LOG_LEVEL=INFO
